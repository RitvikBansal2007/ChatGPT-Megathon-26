# GreenDash edge proxy (Caddy v2).
#
# What this does:
#   * Serves ONLY the Streamlit frontend (127.0.0.1:8501) to the public.
#   * Never proxies the API (127.0.0.1:8000). The Streamlit process calls the API
#     itself over loopback; browsers never need to reach it.
#   * Adds the CSP (font-src 'self', frame-ancestors 'none') and basic security
#     headers to every response, including Caddy-generated errors.
#   * WebSockets (Streamlit's /_stcore/stream) need no extra config: reverse_proxy
#     upgrades them automatically.
#   * TEMPORARY perimeter gate: HTTP Basic Auth in front of EVERYTHING (pages, static
#     files, the WebSocket handshake, and the blocked API paths). This is a shared
#     demo password, not per-user sign-in and not API authorization. See
#     infra/README.md before exposing this to anyone.
#
# Configuration (environment variables, nothing is hard-coded):
#   GREENDASH_DOMAIN   Public hostname only, e.g. dashboard.example.org (no scheme,
#                      no port: it is also used inside the CSP). If unset this falls
#                      back to "localhost" (local testing with Caddy's internal CA).
#                      No production hostname is defined in this repository.
#   GREENDASH_BASIC_AUTH_USER   Demo gate username. REQUIRED.
#   GREENDASH_BASIC_AUTH_HASH   bcrypt hash of the demo password. REQUIRED. Generate
#                               with:  caddy hash-password
#                               Never put a password or hash in this file or in git.
#                      If either is missing or empty, or the hash is not a bcrypt
#                      value, Caddy refuses to start. A hash that is bcrypt-shaped but
#                      wrong makes every login return 401. It never falls back to "no
#                      auth".
#
# Validate:  caddy validate --config infra/Caddyfile --adapter caddyfile
# Run:       GREENDASH_DOMAIN=<your hostname> caddy run --config infra/Caddyfile
# See infra/README.md for the full procedure and the limits of what was verified.
{
	# Keep Caddy's admin API on loopback (this is also the default, stated explicitly).
	admin localhost:2019
}

# Headers applied to normal responses AND to error responses (see handle_errors).
(security_headers) {
	header {
		# CSP written for Streamlit and tested against the real UI (see infra/README.md).
		# Required directives: font-src 'self' and frame-ancestors 'none'.
		# style-src needs 'unsafe-inline' (Streamlit and the brand UI inject inline styles).
		# script-src needs 'unsafe-inline' for Streamlit's bootstrap; 'unsafe-eval' was
		# tested and is NOT needed. connect-src names the site's own wss:// origin
		# explicitly because older Safari does not match 'self' for WebSockets.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$GREENDASH_DOMAIN:localhost}; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Legacy equivalent of frame-ancestors for old browsers.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# Strict-Transport-Security is deliberately NOT set here. Enable it only after
		# HTTPS has been verified on the real hostname (a wrong HSTS value is sticky in
		# browsers for its whole max-age). To enable, uncomment:
		# Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$GREENDASH_DOMAIN:localhost} {
	import security_headers
	encode zstd gzip

	# TEMPORARY perimeter gate. basic_auth runs before every handle/reverse_proxy
	# below, so it covers all paths including the WebSocket upgrade request. Empty
	# env vars make this block malformed, so Caddy will not start without credentials.
	basic_auth bcrypt "GreenDash demo" {
		"{$GREENDASH_BASIC_AUTH_USER}" "{$GREENDASH_BASIC_AUTH_HASH}"
	}

	# Defence in depth: nothing under these paths is ever forwarded. The API is not
	# reachable through this proxy, and Streamlit does not use these paths.
	@api_paths path /api /api/* /docs /docs/* /redoc /openapi.json /healthz
	handle @api_paths {
		respond "Not found" 404
	}

	# The only upstream. Loopback only, never port 8000.
	handle {
		reverse_proxy 127.0.0.1:8501 {
			# The shared demo credential is checked here and not passed to Streamlit.
			header_up -Authorization
			header_down -Server
		}
	}

	# Errors generated by Caddy itself (for example 502 when Streamlit is down) do not
	# inherit the headers above, so they are set again here.
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
