# GreenDash local environment template. PLACEHOLDERS ONLY: no real values belong here.
#
# Copy this file to Code/.env (which is git-ignored) and fill in YOUR OWN values.
# Never commit .env, and never paste a real key into this example file.
#
# Only variables that the code reads today are listed. Names used in the
# architecture document that no code reads yet (HMAC_KEY, LLM_API_KEY) are
# intentionally not listed.
#
# Note: config/settings.py (ENV, JWT_SECRET, GEMINI_API_KEY, DATA_KEY, DATA_KEY_OLD)
# and the LLM client load .env automatically. security/privacy.py (PSEUDONYM_KEY)
# and security/crypto.py read the process environment only, so those variables must
# be exported (or loaded with python-dotenv) before those modules are used.

# --- LLM provider ---------------------------------------------------------
# Read by greenproof/llm/client.py and eval/llm_eval/judge.py
GEMINI_API_KEY=

# Per-run spend cap in GBP. Read by greenproof/llm/explain.py (code default: 5.0)
LLM_BUDGET_GBP=5.0

# --- API authentication (read by config/settings.py) ------------------------
# ENV: "development" (default) or "test" may use a placeholder signing secret and
# keeps /api/auth/demo-token disabled. Set ENV=demo only for the gated demo: it enables
# the demo-token endpoint. ANY other value is treated as a deployed environment.
ENV=development
# HS256 signing secret for API bearer tokens. REQUIRED (32+ characters, not a
# placeholder) whenever ENV is anything other than development/test; the API refuses
# to start otherwise. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# --- Pseudonymous IDs -----------------------------------------------------
# HMAC key used by security/privacy.py pseudonymise(). There is no default and
# the function refuses to run without it. Use a long random value.
PSEUDONYM_KEY=

# --- Field encryption (AES-256-GCM) ----------------------------------------
# Read by security/crypto.py. Must be 32 random bytes, base64 encoded.
# Generate one (run from the repository root) with:
#   python -c "import sys; sys.path.insert(0, 'Code'); from security.crypto import generate_key; print(generate_key())"
DATA_KEY=

# Optional. Retired keys, comma separated, used only to DECRYPT old data after a
# key rotation. Leave empty if you have not rotated.
DATA_KEY_OLD=
