# GreenDash local environment template. PLACEHOLDERS ONLY: no real values belong here.
#
# Copy this file to Code/.env (which is git-ignored) and fill in YOUR OWN values.
# Never commit .env, and never paste a real key into this example file.
#
# Only variables that the code reads today are listed. Names used in the
# architecture document that no code reads yet (HMAC_KEY, LLM_API_KEY, JWT_SECRET)
# are intentionally not listed.
#
# Note: only the LLM client loads .env automatically (greenproof/llm/client.py).
# security/privacy.py and security/crypto.py read the process environment only,
# so the variables below must be loaded (for example with python-dotenv) or
# exported before those modules are used.

# --- LLM provider ---------------------------------------------------------
# Read by greenproof/llm/client.py and eval/llm_eval/judge.py
GEMINI_API_KEY=

# Per-run spend cap in GBP. Read by greenproof/llm/explain.py (code default: 5.0)
LLM_BUDGET_GBP=5.0

# --- Pseudonymous IDs -----------------------------------------------------
# HMAC key used by security/privacy.py pseudonymise(). There is no default and
# the function refuses to run without it. Use a long random value.
PSEUDONYM_KEY=

# --- Field encryption (AES-256-GCM) ----------------------------------------
# Read by security/crypto.py. Must be 32 random bytes, base64 encoded.
# Generate one (run from the repository root) with:
#   python -c "import sys; sys.path.insert(0, 'Code'); from security.crypto import generate_key; print(generate_key())"
DATA_KEY=

# Optional. Retired keys, comma separated, used only to DECRYPT old data after a
# key rotation. Leave empty if you have not rotated.
DATA_KEY_OLD=
